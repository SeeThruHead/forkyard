#!/bin/sh
self="$(realpath "$0")"
root="$(dirname "$self")/.."
entry="$root/dist/bin/forkyard.js"
handed_off="${FORKYARD_HANDED_OFF:-}"
unset FORKYARD_HANDED_OFF

pinned_in() {
  for candidate in "$1/node_modules/forkyard/launcher/forkyard" "$1/tools/forkyard/node_modules/forkyard/launcher/forkyard"; do
    if [ -x "$candidate" ]; then
      realpath "$candidate"
      return 0
    fi
  done
  return 1
}

find_pinned() {
  dir="$PWD"
  while :; do
    if pinned_in "$dir"; then return 0; fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

hand_off_to_pinned() {
  [ -n "$handed_off" ] && return
  pinned="$(find_pinned)" || return
  [ "$pinned" = "$self" ] && return
  FORKYARD_HANDED_OFF=1 exec "$pinned" "$@"
}

hand_off_to_pinned "$@"

if [ -d "$root/.git" ]; then exec "$root/bin/forkyard" "$@"; fi

installed_by_bun() {
  case "$self" in
    "${BUN_INSTALL:-$HOME/.bun}"/install/global/*) return 0 ;;
    *) return 1 ;;
  esac
}

has_node_24() {
  version="$(node --version 2>/dev/null)" || return 1
  major="${version#v}"
  [ "${major%%.*}" -ge 24 ]
}

pick_runtime() {
  if [ -n "${FORKYARD_RUNTIME:-}" ]; then echo "$FORKYARD_RUNTIME"; return; fi
  if installed_by_bun; then echo bun; return; fi
  if has_node_24; then echo node; return; fi
  if command -v bun >/dev/null 2>&1; then echo bun; return; fi
  echo none
}

case "$(pick_runtime)" in
  bun) exec bun --no-env-file --no-install --config=/dev/null "$entry" "$@" ;;
  node) exec node --no-warnings "$entry" "$@" ;;
  *) echo "forkyard needs Node 24 or newer, or Bun. FORKYARD_RUNTIME, if set, must be node or bun." >&2; exit 1 ;;
esac
