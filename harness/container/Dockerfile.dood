FROM forkyard-container-test
ARG DOCKER=27.5.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/$(uname -m)/docker-${DOCKER}.tgz" | tar -xz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker && rm -rf /tmp/docker
COPY app-postgres /app-postgres
WORKDIR /app-postgres
RUN npm install --no-audit --no-fund
ENV FORKYARD_INSTANCE=dood FORKYARD_DOCKER_HOST=host.docker.internal FORKYARD_DOCKER_BIND=0.0.0.0
