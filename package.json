{
  "name": "forkyard",
  "version": "0.1.0",
  "description": "Run many worktrees of the same stack side by side, each at its own URLs, from one daemon.",
  "license": "MIT",
  "bin": {
    "forkyard": "launcher/forkyard"
  },
  "files": [
    "README.md",
    "dashboard/dist",
    "dist",
    "launcher"
  ],
  "type": "module",
  "exports": {
    ".": {
      "forkyard-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "forkyard-source": "./src/Client.ts",
      "types": "./dist/src/Client.d.ts",
      "default": "./dist/src/Client.js"
    },
    "./inputs/moon": {
      "forkyard-source": "./src/inputs/Moon.ts",
      "types": "./dist/src/inputs/Moon.d.ts",
      "default": "./dist/src/inputs/Moon.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "test": "vitest run",
    "daemon": "node --conditions=forkyard-source --no-warnings src/main-daemon.ts",
    "forkyard": "node --conditions=forkyard-source --no-warnings bin/forkyard.ts",
    "build:dashboard": "bun build dashboard/src/main.tsx --outdir dashboard/dist --target browser --minify && cp dashboard/index.html dashboard/dist/index.html",
    "tour": "node --conditions=forkyard-source --no-warnings harness/tour.ts",
    "golden-demo": "node --conditions=forkyard-source --no-warnings harness/golden-demo.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint:fixtures": "oxlint -c test/lint/fixtures.oxlintrc.json test/lint/fixtures",
    "prepare": "lefthook install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && pnpm run build:dashboard",
    "prepack": "pnpm run build",
    "test:container": "harness/container/run.sh"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-pg": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "ink": "8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "4.1.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "rust-just": "1.59.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "effect": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
