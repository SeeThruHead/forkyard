# One schema at the repo root, loaded with varlock.
# Secrets come from scripts/fake-secrets.mjs, which stands in for a cloud secret manager.
# @defaultSensitive=false @defaultRequired=false
# ---

# @type=enum(development, staging, production)
APP_ENV=development

# How services find each other. forkyard replaces these per worktree.
API_URL=http://localhost:4000
SHOP_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001
API_GRAPHQL_URL=${API_URL}/graphql

# Data stores. forkyard replaces these per worktree.
DATABASE_URL=postgres://postgres@localhost:5432/storefront
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_HTTP_URL=http://localhost:7243
TEMPORAL_UI_URL=http://localhost:8233
TEMPORAL_NAMESPACE_ORDERS=orders
TEMPORAL_NAMESPACE_FULFILLMENT=fulfillment
TEMPORAL_NAMESPACE_NOTIFICATIONS=notifications

# Shared development resources from the secret manager. Every worktree gets the same values.
AUTH_ISSUER_URL=exec(`node scripts/fake-secrets.mjs auth/issuer-url`)
AUTH_CLIENT_ID=exec(`node scripts/fake-secrets.mjs auth/client-id`)
# @sensitive
PAYMENTS_SECRET_KEY=exec(`node scripts/fake-secrets.mjs payments/secret-key`)
# @sensitive
SESSION_SECRET=exec(`node scripts/fake-secrets.mjs app/session-secret`)

# Not mapped in forkyard.config.ts on purpose, so the dashboard flags it.
ANALYTICS_HOST=http://localhost:8010
