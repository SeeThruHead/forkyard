# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# @type=enum(local, dev)
APP_ENV=local

# --- Backend URLs (core API and graph go through the Vite proxy locally) ---
REACT_APP_API_URL=if(eq(ref(APP_ENV), "local"), "/core-api")
GRAPH_URL=if(eq(ref(APP_ENV), "local"), "/graph-api")
BILLING_API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:3100")
IMAGE_API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:4401")
SIGN_IN_URL=if(eq(ref(APP_ENV), "local"), "http://login.northwind.localhost:4503")

# --- Feature flags (local stand-in for the flag vendor) ---------------------
FLAGS_BASE_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_STREAM_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_EVENTS_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")

OTEL_EXPORTER_OTLP_ENDPOINT=if(eq(ref(APP_ENV), "local"), "http://localhost:14319")
