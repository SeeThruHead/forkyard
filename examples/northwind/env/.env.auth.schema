# @type=enum(local, dev)
APP_ENV=local

ISSUER=if(eq(ref(APP_ENV), "local"), "http://login.northwind.localhost:4504")
UI_ORIGIN=if(eq(ref(APP_ENV), "local"), "http://login.northwind.localhost:4503")
PORT=if(eq(ref(APP_ENV), "local"), 4504)
REDIS_URL=if(eq(ref(APP_ENV), "local"), "redis://localhost:6379")
DEFAULT_POST_LOGIN_URL=if(eq(ref(APP_ENV), "local"), "http://portal.northwind.localhost:5273/login")
CLIENTS_JSON=if(eq(ref(APP_ENV), "local"), "[{\"id\":\"portal\",\"redirect_uris\":[\"http://portal.northwind.localhost:5273/login\"]}]")
