# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# @type=enum(local, dev)
APP_ENV=local

# --- Database ---------------------------------------------------------------
DB_HOST=if(eq(ref(APP_ENV), "local"), "localhost")
DB_PORT=if(eq(ref(APP_ENV), "local"), 5432)
DB_USERNAME=if(eq(ref(APP_ENV), "local"), "postgres")
DB_PASSWORD=if(eq(ref(APP_ENV), "local"), "postgres")
DB_DATABASE=if(eq(ref(APP_ENV), "local"), "northwind_dev")

# --- Redis ------------------------------------------------------------------
REDIS_HOST=if(eq(ref(APP_ENV), "local"), "localhost")
REDIS_PORT=if(eq(ref(APP_ENV), "local"), 6379)

# --- NATS -------------------------------------------------------------------
NATS_URL=if(eq(ref(APP_ENV), "local"), "nats://localhost:4222")

# --- Temporal ---------------------------------------------------------------
TEMPORAL_PLATFORM_ADDRESS=if(eq(ref(APP_ENV), "local"), "localhost:7233")
TEMPORAL_PLATFORM_NAMESPACE=platform
TEMPORAL_BULK_ADDRESS=if(eq(ref(APP_ENV), "local"), "localhost:7233")
TEMPORAL_BULK_NAMESPACE=bulk-actions

# --- Auth -------------------------------------------------------------------
# @sensitive
SESSION_SECRET=if(eq(ref(APP_ENV), "local"), "local-session-secret")
# @sensitive
INTERNAL_HTTP_SHARED_SECRET=if(eq(ref(APP_ENV), "local"), "local-internal-http-secret")
AUTH_ISSUER=if(eq(ref(APP_ENV), "local"), "http://login.northwind.localhost:4504")

# --- Feature flags (local stand-in for the flag vendor) ---------------------
FLAGS_BASE_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_STREAM_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_EVENTS_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")

# --- Other services ---------------------------------------------------------
API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:8181")
PORTAL_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:5273")
CATALOG_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4424")
OBJECT_STORE_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4425")
IMAGE_API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:4401")
MAIL_API_BASE=if(eq(ref(APP_ENV), "local"), "http://localhost:8191")
ALLOWED_ORIGINS=if(eq(ref(APP_ENV), "local"), "http://localhost:5273,http://localhost:5274")

# --- Pulled from the secrets store in deployed environments -----------------
# @sensitive
PARTNER_API_KEY=exec(`node ./tools/fake-secrets/get.ts dev/northwind/core-api PARTNER_API_KEY`)
