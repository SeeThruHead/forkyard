# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# @type=enum(local, dev)
APP_ENV=local

DB_USER=if(eq(ref(APP_ENV), "local"), "postgres")
DB_PASSWORD=if(eq(ref(APP_ENV), "local"), "postgres")
DB_HOST=if(eq(ref(APP_ENV), "local"), "127.0.0.1")
DB_PORT=if(eq(ref(APP_ENV), "local"), 5433)
DB_NAME=if(eq(ref(APP_ENV), "local"), "billing")
DATABASE_URL=if(eq(ref(APP_ENV), "local"), concat("postgresql://", ref(DB_USER), ":", ref(DB_PASSWORD), "@", ref(DB_HOST), ":", ref(DB_PORT), "/", ref(DB_NAME)))
NATS_URL=if(eq(ref(APP_ENV), "local"), "nats://127.0.0.1:4222")
TEMPORAL_ADDRESS=if(eq(ref(APP_ENV), "local"), "127.0.0.1:7233")
TEMPORAL_NAMESPACE=billing
CORE_API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:8181")
# @sensitive
CORE_API_INTERNAL_HTTP_SHARED_SECRET=if(eq(ref(APP_ENV), "local"), "local-internal-http-secret")
# @sensitive
INTERNAL_HTTP_SHARED_SECRET=if(eq(ref(APP_ENV), "local"), "local-internal-http-secret")
# @optional
HEALTH_PORT=if(eq(ref(APP_ENV), "local"), 3102)
# @optional
PORT=
ALLOWED_ORIGINS=if(eq(ref(APP_ENV), "local"), "http://localhost:5274")

# --- Feature flags (local stand-in for the flag vendor) ---------------------
FLAGS_BASE_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_STREAM_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")
FLAGS_EVENTS_URL=if(eq(ref(APP_ENV), "local"), "http://127.0.0.1:4416")

# --- Pulled from the secrets store in deployed environments -----------------
CATALOG_BUCKET=exec(`node ./tools/fake-secrets/get.ts dev/northwind/billing CATALOG_BUCKET`)
# @sensitive
PROVIDER_API_KEY=exec(`node ./tools/fake-secrets/get.ts dev/northwind/billing PROVIDER_API_KEY`)
