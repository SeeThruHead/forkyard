# @type=enum(local, dev)
APP_ENV=local

DATABASE_URL=if(eq(ref(APP_ENV), "local"), "postgresql://postgres:postgres@localhost:5432/northwind_dev")
NATS_URL=if(eq(ref(APP_ENV), "local"), "nats://localhost:4222")
HEALTH_PORT=if(eq(ref(APP_ENV), "local"), 3103)
