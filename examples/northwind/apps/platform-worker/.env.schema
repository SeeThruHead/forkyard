# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# @type=enum(local, dev)
APP_ENV=local

DATABASE_URL=if(eq(ref(APP_ENV), "local"), "postgresql://postgres:postgres@localhost:5432/northwind_dev")
TEMPORAL_PLATFORM_ADDRESS=if(eq(ref(APP_ENV), "local"), "localhost:7233")
TEMPORAL_PLATFORM_NAMESPACE=platform
TEMPORAL_CRONS_ADDRESS=if(eq(ref(APP_ENV), "local"), "localhost:7233")
TEMPORAL_CRONS_NAMESPACE=crons
TEMPORAL_BULK_ADDRESS=if(eq(ref(APP_ENV), "local"), "localhost:7233")
TEMPORAL_BULK_NAMESPACE=bulk-actions
BILLING_API_URL=if(eq(ref(APP_ENV), "local"), "http://localhost:3100")
# @sensitive
BILLING_INTERNAL_HTTP_SHARED_SECRET=if(eq(ref(APP_ENV), "local"), "local-internal-http-secret")
# @optional
HEALTH_PORT=
